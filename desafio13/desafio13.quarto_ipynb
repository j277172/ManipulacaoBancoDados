      "source": [
        "import sqlite3\n",
        "import os\n",
        "\n",
        "# Conectar ao banco de dados\n",
        "DB_PATH = os.path.join('desafio13', 'movies.sqlite3')\n",
        "conn = sqlite3.connect(DB_PATH)\n",
        "cursor = conn.cursor()\n",
        "\n",
        "print(\"=\" * 70)\n",
        "print(\"TOP 5 FILMES COM MAIORES NOTAS\")\n",
        "print(\"=\" * 70)\n",
        "\n",
        "# Query SQL para encontrar os 5 filmes com maiores notas\n",
        "# Ordenando por averageRating (descendente) e numVotes (descendente) para desempate\n",
        "# Filtrando apenas filmes (titleType = 'movie')\n",
        "query = \"\"\"\n",
        "SELECT \n",
        "    b.tconst,\n",
        "    b.primaryTitle,\n",
        "    b.titleType,\n",
        "    b.startYear,\n",
        "    r.averageRating,\n",
        "    r.numVotes\n",
        "FROM basics b\n",
        "INNER JOIN ratings r ON b.tconst = r.tconst\n",
        "WHERE b.titleType = 'movie'\n",
        "ORDER BY r.averageRating DESC, r.numVotes DESC\n",
        "LIMIT 5;\n",
        "\"\"\"\n",
        "\n",
        "print(\"\\nExecutando consulta SQL...\")\n",
        "print(\"\\nQuery:\")\n",
        "print(query)\n",
        "\n",
        "cursor.execute(query)\n",
        "resultados = cursor.fetchall()\n",
        "\n",
        "print(\"\\n\" + \"=\" * 70)\n",
        "print(\"RESULTADOS\")\n",
        "print(\"=\" * 70)\n",
        "\n",
        "if resultados:\n",
        "    print(f\"\\nEncontrados {len(resultados)} filmes:\\n\")\n",
        "    \n",
        "    for i, filme in enumerate(resultados, 1):\n",
        "        tconst, titulo, tipo, ano, nota, votos = filme\n",
        "        \n",
        "        print(f\"{i}. {titulo}\")\n",
        "        print(f\"   ID: {tconst}\")\n",
        "        print(f\"   Ano: {ano if ano else 'N/A'}\")\n",
        "        print(f\"   Tipo: {tipo}\")\n",
        "        print(f\"   Nota: {nota}\")\n",
        "        print(f\"   Votos: {int(votos) if votos else 0:,}\")\n",
        "        print()\n",
        "else:\n",
        "    print(\"\\nNenhum resultado encontrado!\")\n",
        "\n",
        "print(\"=\" * 70)\n",
        "\n",
        "# Versão alternativa: Top 5 filmes considerando apenas filmes com >= 10.000 votos\n",
        "# (para filtrar filmes obscuros com poucas avaliações)\n",
        "print(\"\\nBÔNUS: TOP 5 FILMES COM >= 10.000 VOTOS\")\n",
        "print(\"=\" * 70)\n",
        "\n",
        "query_filtrado = \"\"\"\n",
        "SELECT \n",
        "    b.tconst,\n",
        "    b.primaryTitle,\n",
        "    b.titleType,\n",
        "    b.startYear,\n",
        "    r.averageRating,\n",
        "    r.numVotes\n",
        "FROM basics b\n",
        "INNER JOIN ratings r ON b.tconst = r.tconst\n",
        "WHERE b.titleType = 'movie' AND r.numVotes >= 10000\n",
        "ORDER BY r.averageRating DESC, r.numVotes DESC\n",
        "LIMIT 5;\n",
        "\"\"\"\n",
        "\n",
        "cursor.execute(query_filtrado)\n",
        "resultados_filtrados = cursor.fetchall()\n",
        "\n",
        "if resultados_filtrados:\n",
        "    print(f\"\\nEncontrados {len(resultados_filtrados)} filmes:\\n\")\n",
        "    \n",
        "    for i, filme in enumerate(resultados_filtrados, 1):\n",
        "        tconst, titulo, tipo, ano, nota, votos = filme\n",
        "        \n",
        "        print(f\"{i}. {titulo}\")\n",
        "        print(f\"   ID: {tconst}\")\n",
        "        print(f\"   Ano: {ano if ano else 'N/A'}\")\n",
        "        print(f\"   Nota: {nota}\")\n",
        "        print(f\"   Votos: {int(votos) if votos else 0:,}\")\n",
        "        print()\n",
        "\n",
        "print(\"=\" * 70)\n",
        "\n",
        "# Fechar conexão\n",
        "conn.close()\n",
        "\n",
        "print(\"✓ CONSULTA CONCLUÍDA!\")\n",
        "print(\"=\" * 70)"
      ],
