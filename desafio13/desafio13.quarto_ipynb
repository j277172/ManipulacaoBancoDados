    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "import sqlite3\n",
        "import os\n",
        "\n",
        "# Conectar ao banco de dados\n",
        "DB_PATH = os.path.join('desafio13', 'movies.sqlite3')\n",
        "conn = sqlite3.connect(DB_PATH)\n",
        "cursor = conn.cursor()\n",
        "\n",
        "print(\"=\" * 70)\n",
        "print(\"TOP 3 ATORES/ATRIZES EM FILMES COM NOTA > 7.5\")\n",
        "print(\"=\" * 70)\n",
        "\n",
        "# Query SQL para encontrar os atores/atrizes mais frequentes\n",
        "# Filtrando por category = 'actor' ou 'actress'\n",
        "query = \"\"\"\n",
        "SELECT \n",
        "    p.nconst,\n",
        "    COUNT(DISTINCT p.tconst) as num_filmes,\n",
        "    AVG(r.averageRating) as nota_media,\n",
        "    MIN(r.averageRating) as nota_minima,\n",
        "    MAX(r.averageRating) as nota_maxima\n",
        "FROM principals p\n",
        "INNER JOIN ratings r ON p.tconst = r.tconst\n",
        "INNER JOIN basics b ON p.tconst = b.tconst\n",
        "WHERE b.titleType = 'movie'\n",
        "  AND r.averageRating > 7.5\n",
        "  AND (p.category = 'actor' OR p.category = 'actress')\n",
        "GROUP BY p.nconst\n",
        "ORDER BY num_filmes DESC\n",
        "LIMIT 3;\n",
        "\"\"\"\n",
        "\n",
        "print(\"\\nExecutando consulta SQL...\")\n",
        "print(\"\\nQuery:\")\n",
        "print(query)\n",
        "\n",
        "cursor.execute(query)\n",
        "resultados = cursor.fetchall()\n",
        "\n",
        "print(\"\\n\" + \"=\" * 70)\n",
        "print(\"RESULTADOS - TOP 3 ATORES/ATRIZES\")\n",
        "print(\"=\" * 70)\n",
        "\n",
        "if resultados:\n",
        "    print(f\"\\nEncontrados {len(resultados)} atores/atrizes:\\n\")\n",
        "    \n",
        "    for i, ator in enumerate(resultados, 1):\n",
        "        nconst, num_filmes, nota_media, nota_min, nota_max = ator\n",
        "        \n",
        "        print(f\"{i}. ID: {nconst}\")\n",
        "        print(f\"   Número de filmes (nota > 7.5): {num_filmes:,}\")\n",
        "        print(f\"   Nota média dos filmes: {nota_media:.2f}\")\n",
        "        print(f\"   Nota mínima: {nota_min:.2f}\")\n",
        "        print(f\"   Nota máxima: {nota_max:.2f}\")\n",
        "        print()\n",
        "else:\n",
        "    print(\"\\nNenhum resultado encontrado!\")\n",
        "\n",
        "print(\"=\" * 70)\n",
        "\n",
        "# Versão detalhada: Separando atores e atrizes\n",
        "print(\"\\nANÁLISE SEPARADA POR CATEGORIA\")\n",
        "print(\"=\" * 70)\n",
        "\n",
        "# Top 3 Atores\n",
        "print(\"\\nTOP 3 ATORES (category = 'actor'):\")\n",
        "query_atores = \"\"\"\n",
        "SELECT \n",
        "    p.nconst,\n",
        "    COUNT(DISTINCT p.tconst) as num_filmes,\n",
        "    AVG(r.averageRating) as nota_media\n",
        "FROM principals p\n",
        "INNER JOIN ratings r ON p.tconst = r.tconst\n",
        "INNER JOIN basics b ON p.tconst = b.tconst\n",
        "WHERE b.titleType = 'movie'\n",
        "  AND r.averageRating > 7.5\n",
        "  AND p.category = 'actor'\n",
        "GROUP BY p.nconst\n",
        "ORDER BY num_filmes DESC\n",
        "LIMIT 3;\n",
        "\"\"\"\n",
        "\n",
        "cursor.execute(query_atores)\n",
        "atores = cursor.fetchall()\n",
        "\n",
        "for i, ator in enumerate(atores, 1):\n",
        "    nconst, num_filmes, nota_media = ator\n",
        "    print(f\"  {i}. ID: {nconst} - {num_filmes:,} filmes (média: {nota_media:.2f})\")\n",
        "\n",
        "# Top 3 Atrizes\n",
        "print(\"\\nTOP 3 ATRIZES (category = 'actress'):\")\n",
        "query_atrizes = \"\"\"\n",
        "SELECT \n",
        "    p.nconst,\n",
        "    COUNT(DISTINCT p.tconst) as num_filmes,\n",
        "    AVG(r.averageRating) as nota_media\n",
        "FROM principals p\n",
        "INNER JOIN ratings r ON p.tconst = r.tconst\n",
        "INNER JOIN basics b ON p.tconst = b.tconst\n",
        "WHERE b.titleType = 'movie'\n",
        "  AND r.averageRating > 7.5\n",
        "  AND p.category = 'actress'\n",
        "GROUP BY p.nconst\n",
        "ORDER BY num_filmes DESC\n",
        "LIMIT 3;\n",
        "\"\"\"\n",
        "\n",
        "cursor.execute(query_atrizes)\n",
        "atrizes = cursor.fetchall()\n",
        "\n",
        "for i, atriz in enumerate(atrizes, 1):\n",
        "    nconst, num_filmes, nota_media = atriz\n",
        "    print(f\"  {i}. ID: {nconst} - {num_filmes:,} filmes (média: {nota_media:.2f})\")\n",
        "\n",
        "# Estatísticas gerais\n",
        "print(\"\\n\" + \"=\" * 70)\n",
        "print(\"ESTATÍSTICAS GERAIS\")\n",
        "print(\"=\" * 70)\n",
        "\n",
        "query_stats = \"\"\"\n",
        "SELECT \n",
        "    p.category,\n",
        "    COUNT(DISTINCT p.nconst) as num_pessoas,\n",
        "    COUNT(DISTINCT p.tconst) as num_filmes,\n",
        "    AVG(r.averageRating) as nota_media\n",
        "FROM principals p\n",
        "INNER JOIN ratings r ON p.tconst = r.tconst\n",
        "INNER JOIN basics b ON p.tconst = b.tconst\n",
        "WHERE b.titleType = 'movie'\n",
        "  AND r.averageRating > 7.5\n",
        "  AND (p.category = 'actor' OR p.category = 'actress')\n",
        "GROUP BY p.category;\n",
        "\"\"\"\n",
        "\n",
        "cursor.execute(query_stats)\n",
        "stats = cursor.fetchall()\n",
        "\n",
        "print(\"\\nEstatísticas por categoria:\")\n",
        "for stat in stats:\n",
        "    categoria, num_pessoas, num_filmes, nota_media = stat\n",
        "    print(f\"\\n{categoria.upper()}:\")\n",
        "    print(f\"  - Total de {categoria}s diferentes: {num_pessoas:,}\")\n",
        "    print(f\"  - Total de participações em filmes: {num_filmes:,}\")\n",
        "    print(f\"  - Nota média dos filmes: {nota_media:.2f}\")\n",
        "\n",
        "# Total geral de filmes com nota > 7.5\n",
        "query_total = \"\"\"\n",
        "SELECT COUNT(DISTINCT b.tconst)\n",
        "FROM basics b\n",
        "INNER JOIN ratings r ON b.tconst = r.tconst\n",
        "WHERE b.titleType = 'movie'\n",
        "  AND r.averageRating > 7.5;\n",
        "\"\"\"\n",
        "\n",
        "cursor.execute(query_total)\n",
        "total_filmes = cursor.fetchone()[0]\n",
        "\n",
        "print(f\"\\nTotal de filmes com nota > 7.5: {total_filmes:,}\")\n",
        "\n",
        "# Fechar conexão\n",
        "conn.close()\n",
        "\n",
        "print(\"\\n\" + \"=\" * 70)\n",
        "print(\"✓ CONSULTA CONCLUÍDA!\")\n",
        "print(\"=\" * 70)"
      ],
      "id": "01c45c92",
      "execution_count": null,
      "outputs": []
    }
