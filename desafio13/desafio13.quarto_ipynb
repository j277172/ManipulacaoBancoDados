    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "import sqlite3\n",
        "import os\n",
        "\n",
        "# Conectar ao banco de dados\n",
        "DB_PATH = os.path.join('desafio13', 'movies.sqlite3')\n",
        "conn = sqlite3.connect(DB_PATH)\n",
        "cursor = conn.cursor()\n",
        "\n",
        "print(\"=\" * 70)\n",
        "print(\"GÊNERO MAIS FREQUENTE EM FILMES COM NOTA > 8\")\n",
        "print(\"=\" * 70)\n",
        "\n",
        "# Query SQL para encontrar o gênero mais frequente\n",
        "# Nota: A coluna genres contém múltiplos gêneros separados por vírgula\n",
        "# Exemplo: \"Drama,Romance,War\"\n",
        "query = \"\"\"\n",
        "SELECT \n",
        "    b.genres,\n",
        "    COUNT(*) as frequencia,\n",
        "    AVG(r.averageRating) as nota_media,\n",
        "    COUNT(*) * 100.0 / (SELECT COUNT(*) \n",
        "                        FROM basics b2 \n",
        "                        INNER JOIN ratings r2 ON b2.tconst = r2.tconst \n",
        "                        WHERE b2.titleType = 'movie' \n",
        "                        AND r2.averageRating > 8 \n",
        "                        AND b2.genres IS NOT NULL) as percentual\n",
        "FROM basics b\n",
        "INNER JOIN ratings r ON b.tconst = r.tconst\n",
        "WHERE b.titleType = 'movie' \n",
        "  AND r.averageRating > 8\n",
        "  AND b.genres IS NOT NULL\n",
        "GROUP BY b.genres\n",
        "ORDER BY frequencia DESC\n",
        "LIMIT 10;\n",
        "\"\"\"\n",
        "\n",
        "print(\"\\nExecutando consulta SQL...\")\n",
        "print(\"\\nQuery (Top 10 combinações de gêneros):\")\n",
        "cursor.execute(query)\n",
        "resultados = cursor.fetchall()\n",
        "\n",
        "print(\"\\n\" + \"=\" * 70)\n",
        "print(\"RESULTADOS - TOP 10 COMBINAÇÕES DE GÊNEROS\")\n",
        "print(\"=\" * 70)\n",
        "\n",
        "if resultados:\n",
        "    print(f\"\\nTotal de combinações encontradas: {len(resultados)}\\n\")\n",
        "    \n",
        "    for i, resultado in enumerate(resultados, 1):\n",
        "        genero, freq, nota_media, percentual = resultado\n",
        "        print(f\"{i}. {genero}\")\n",
        "        print(f\"   Frequência: {freq:,} filmes\")\n",
        "        print(f\"   Nota média: {nota_media:.2f}\")\n",
        "        print(f\"   Percentual: {percentual:.2f}%\")\n",
        "        print()\n",
        "\n",
        "print(\"=\" * 70)\n",
        "\n",
        "# Análise por gênero individual (separando os gêneros compostos)\n",
        "print(\"\\nANÁLISE POR GÊNERO INDIVIDUAL\")\n",
        "print(\"=\" * 70)\n",
        "\n",
        "# Primeiro, buscar todos os filmes com nota > 8 e seus gêneros\n",
        "query_generos = \"\"\"\n",
        "SELECT b.genres\n",
        "FROM basics b\n",
        "INNER JOIN ratings r ON b.tconst = r.tconst\n",
        "WHERE b.titleType = 'movie' \n",
        "  AND r.averageRating > 8\n",
        "  AND b.genres IS NOT NULL;\n",
        "\"\"\"\n",
        "\n",
        "cursor.execute(query_generos)\n",
        "todos_generos = cursor.fetchall()\n",
        "\n",
        "# Processar os gêneros (separar por vírgula e contar individualmente)\n",
        "contagem_generos = {}\n",
        "total_filmes = 0\n",
        "\n",
        "for linha in todos_generos:\n",
        "    generos = linha[0]\n",
        "    if generos:\n",
        "        # Separar por vírgula e processar cada gênero\n",
        "        lista_generos = [g.strip() for g in generos.split(',')]\n",
        "        total_filmes += 1\n",
        "        for genero in lista_generos:\n",
        "            if genero:  # Ignorar strings vazias\n",
        "                contagem_generos[genero] = contagem_generos.get(genero, 0) + 1\n",
        "\n",
        "# Ordenar por frequência\n",
        "generos_ordenados = sorted(contagem_generos.items(), key=lambda x: x[1], reverse=True)\n",
        "\n",
        "print(f\"\\nTotal de filmes analisados: {total_filmes:,}\")\n",
        "print(f\"Gêneros únicos encontrados: {len(generos_ordenados)}\\n\")\n",
        "\n",
        "print(\"TOP 10 GÊNEROS INDIVIDUAIS:\\n\")\n",
        "for i, (genero, freq) in enumerate(generos_ordenados[:10], 1):\n",
        "    percentual = (freq / total_filmes) * 100\n",
        "    print(f\"{i}. {genero}\")\n",
        "    print(f\"   Aparece em: {freq:,} filmes\")\n",
        "    print(f\"   Percentual: {percentual:.2f}%\")\n",
        "    print()\n",
        "\n",
        "# Destacar o gênero mais frequente\n",
        "if generos_ordenados:\n",
        "    genero_mais_frequente, freq_max = generos_ordenados[0]\n",
        "    print(\"=\" * 70)\n",
        "    print(f\"\\n🏆 GÊNERO MAIS FREQUENTE: {genero_mais_frequente}\")\n",
        "    print(f\"   Aparece em {freq_max:,} filmes ({(freq_max/total_filmes)*100:.2f}%)\")\n",
        "    print(\"\\n\" + \"=\" * 70)\n",
        "\n",
        "# Estatísticas adicionais\n",
        "print(\"\\nESTATÍSTICAS ADICIONAIS\")\n",
        "print(\"=\" * 70)\n",
        "\n",
        "query_stats = \"\"\"\n",
        "SELECT \n",
        "    COUNT(DISTINCT b.tconst) as total_filmes,\n",
        "    AVG(r.averageRating) as nota_media,\n",
        "    MIN(r.averageRating) as nota_minima,\n",
        "    MAX(r.averageRating) as nota_maxima,\n",
        "    AVG(r.numVotes) as media_votos\n",
        "FROM basics b\n",
        "INNER JOIN ratings r ON b.tconst = r.tconst\n",
        "WHERE b.titleType = 'movie' \n",
        "  AND r.averageRating > 8;\n",
        "\"\"\"\n",
        "\n",
        "cursor.execute(query_stats)\n",
        "stats = cursor.fetchone()\n",
        "\n",
        "if stats:\n",
        "    total, media, minima, maxima, votos = stats\n",
        "    print(f\"\\nFilmes com nota > 8:\")\n",
        "    print(f\"  - Total de filmes: {int(total):,}\")\n",
        "    print(f\"  - Nota média: {media:.2f}\")\n",
        "    print(f\"  - Nota mínima: {minima:.2f}\")\n",
        "    print(f\"  - Nota máxima: {maxima:.2f}\")\n",
        "    print(f\"  - Média de votos: {int(votos):,}\")\n",
        "\n",
        "# Fechar conexão\n",
        "conn.close()\n",
        "\n",
        "print(\"\\n\" + \"=\" * 70)\n",
        "print(\"✓ ANÁLISE CONCLUÍDA!\")\n",
        "print(\"=\" * 70)"
      ],
