        "import sqlite3\n",
        "import os\n",
        "\n",
        "# Caminho do arquivo\n",
        "DB_PATH = os.path.join('desafio13', 'movies.sqlite3')\n",
        "\n",
        "# Conectar ao banco de dados\n",
        "conn = sqlite3.connect(DB_PATH)\n",
        "cursor = conn.cursor()\n",
        "\n",
        "print(\"=\" * 70)\n",
        "print(\"EXPLORANDO BANCO DE DADOS: movies.sqlite3\")\n",
        "print(\"=\" * 70)\n",
        "\n",
        "# 1. LISTAR TODAS AS TABELAS\n",
        "print(\"\\n[TABELAS NO BANCO DE DADOS]\")\n",
        "cursor.execute(\"SELECT name FROM sqlite_master WHERE type='table';\")\n",
        "tabelas = cursor.fetchall()\n",
        "\n",
        "if tabelas:\n",
        "    print(f\"Total de tabelas: {len(tabelas)}\")\n",
        "    for i, tabela in enumerate(tabelas, 1):\n",
        "        print(f\"  {i}. {tabela[0]}\")\n",
        "else:\n",
        "    print(\"  Nenhuma tabela encontrada!\")\n",
        "\n",
        "print(\"\\n\" + \"=\" * 70)\n",
        "\n",
        "# 2. DETALHES DE CADA TABELA\n",
        "for tabela in tabelas:\n",
        "    nome_tabela = tabela[0]\n",
        "    print(f\"\\n[TABELA: {nome_tabela.upper()}]\")\n",
        "    \n",
        "    # Contar registros\n",
        "    cursor.execute(f\"SELECT COUNT(*) FROM {nome_tabela}\")\n",
        "    count = cursor.fetchone()[0]\n",
        "    print(f\"  - Total de registros: {count:,}\")\n",
        "    \n",
        "    # Listar colunas e tipos\n",
        "    cursor.execute(f\"PRAGMA table_info({nome_tabela})\")\n",
        "    colunas = cursor.fetchall()\n",
        "    \n",
        "    print(f\"  - Colunas ({len(colunas)}):\")\n",
        "    for col in colunas:\n",
        "        col_id, col_name, col_type, not_null, default_val, pk = col\n",
        "        pk_info = \" [PRIMARY KEY]\" if pk else \"\"\n",
        "        null_info = \" [NOT NULL]\" if not_null else \"\"\n",
        "        print(f\"      • {col_name} ({col_type}){pk_info}{null_info}\")\n",
        "    \n",
        "    # Mostrar amostra de dados (primeiras 3 linhas)\n",
        "    cursor.execute(f\"SELECT * FROM {nome_tabela} LIMIT 3\")\n",
        "    amostra = cursor.fetchall()\n",
        "    \n",
        "    if amostra:\n",
        "        print(f\"  - Amostra de dados (3 primeiras linhas):\")\n",
        "        colunas_nomes = [col[1] for col in colunas]\n",
        "        \n",
        "        for i, linha in enumerate(amostra, 1):\n",
        "            print(f\"      Linha {i}:\")\n",
        "            for j, valor in enumerate(linha):\n",
        "                if j < 5:  # Mostrar apenas as 5 primeiras colunas\n",
        "                    print(f\"        {colunas_nomes[j]}: {valor}\")\n",
        "            if len(linha) > 5:\n",
        "                print(f\"        ... (mais {len(linha)-5} colunas)\")\n",
        "    \n",
        "    print()\n",
        "\n",
        "# 3. VERIFICAR ÍNDICES\n",
        "print(\"=\" * 70)\n",
        "print(\"\\n[ÍNDICES DO BANCO DE DADOS]\")\n",
        "cursor.execute(\"SELECT name, tbl_name FROM sqlite_master WHERE type='index';\")\n",
        "indices = cursor.fetchall()\n",
        "\n",
        "if indices:\n",
        "    print(f\"Total de índices: {len(indices)}\")\n",
        "    for idx, tabela in indices:\n",
        "        print(f\"  - {idx} (tabela: {tabela})\")\n",
        "else:\n",
        "    print(\"  Nenhum índice encontrado!\")\n",
        "\n",
        "# 4. VIEWS (se houver)\n",
        "print(\"\\n[VIEWS DO BANCO DE DADOS]\")\n",
        "cursor.execute(\"SELECT name FROM sqlite_master WHERE type='view';\")\n",
        "views = cursor.fetchall()\n",
        "\n",
        "if views:\n",
        "    print(f\"Total de views: {len(views)}\")\n",
        "    for view in views:\n",
        "        print(f\"  - {view[0]}\")\n",
        "else:\n",
        "    print(\"  Nenhuma view encontrada!\")\n",
        "\n",
        "# Fechar conexão\n",
        "conn.close()\n",
        "\n",
        "print(\"\\n\" + \"=\" * 70)\n",
        "print(\"✓ EXPLORAÇÃO CONCLUÍDA!\")\n",
        "print(\"=\" * 70)"
      ],
