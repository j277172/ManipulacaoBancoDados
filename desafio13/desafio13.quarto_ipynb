    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "import pandas as pd\n",
        "import sqlite3\n",
        "import os\n",
        "\n",
        "# Definir o caminho da pasta com os arquivos\n",
        "PASTA = 'desafio13'\n",
        "\n",
        "# Definir os arquivos e suas respectivas tabelas\n",
        "ARQUIVOS = {\n",
        "    'basics': 'title.basics0.tsv.gz',\n",
        "    'ratings': 'title.ratings.tsv.gz',\n",
        "    'principals': 'title.principals0.tsv.gz'\n",
        "}\n",
        "\n",
        "# Nome do banco de dados\n",
        "DB_NAME = 'imdb_database.db'\n",
        "\n",
        "def criar_banco_dados():\n",
        "    '''Cria banco de dados SQLite a partir dos arquivos TSV.GZ'''\n",
        "    \n",
        "    # Criar conexão com o banco de dados\n",
        "    conn = sqlite3.connect(DB_NAME)\n",
        "    \n",
        "    print(\"=\" * 70)\n",
        "    print(\"CRIANDO BANCO DE DADOS SQLite\")\n",
        "    print(\"=\" * 70)\n",
        "    \n",
        "    # Processar cada arquivo\n",
        "    for nome_tabela, nome_arquivo in ARQUIVOS.items():\n",
        "        caminho_completo = os.path.join(PASTA, nome_arquivo)\n",
        "        \n",
        "        print(f\"\\n[{nome_tabela.upper()}]\")\n",
        "        print(f\"Arquivo: {nome_arquivo}\")\n",
        "        \n",
        "        try:\n",
        "            # Especificar dtypes mais eficientes para reduzir uso de memória\n",
        "            # Usar 'object' para strings e tipos menores para números quando possível\n",
        "            dtype_specs = {\n",
        "                'basics': {\n",
        "                    'isAdult': 'Int8',\n",
        "                    'startYear': 'Int16',\n",
        "                    'endYear': 'Int16',\n",
        "                    'runtimeMinutes': 'Int16'\n",
        "                },\n",
        "                'ratings': {\n",
        "                    'averageRating': 'float32',\n",
        "                    'numVotes': 'Int32'\n",
        "                },\n",
        "                'principals': {\n",
        "                    'ordering': 'Int16'\n",
        "                }\n",
        "            }\n",
        "            \n",
        "            # Obter dtypes específicos para a tabela atual\n",
        "            dtype = dtype_specs.get(nome_tabela, None)\n",
        "            \n",
        "            # Verificar o tamanho do arquivo para decidir estratégia\n",
        "            tamanho_arquivo = os.path.getsize(caminho_completo) / (1024 * 1024)  # em MB\n",
        "            usar_chunks = tamanho_arquivo > 100  # Usar chunks para arquivos > 100MB\n",
        "            \n",
        "            if usar_chunks:\n",
        "                print(f\"  - Arquivo grande ({tamanho_arquivo:.1f} MB) - usando leitura em chunks\")\n",
        "                \n",
        "                # Ler em chunks para arquivos grandes\n",
        "                chunk_size = 50000  # Processar 50.000 linhas por vez\n",
        "                chunks = pd.read_csv(\n",
        "                    caminho_completo,\n",
        "                    sep='\\t',\n",
        "                    compression='gzip',\n",
        "                    na_values='\\\\N',\n",
        "                    dtype=dtype,\n",
        "                    chunksize=chunk_size,\n",
        "                    low_memory=False\n",
        "                )\n",
        "                \n",
        "                # Processar cada chunk\n",
        "                total_linhas = 0\n",
        "                for i, chunk in enumerate(chunks):\n",
        "                    if i == 0:\n",
        "                        # Primeira iteração: criar tabela\n",
        "                        chunk.to_sql(\n",
        "                            nome_tabela,\n",
        "                            conn,\n",
        "                            if_exists='replace',\n",
        "                            index=False\n",
        "                        )\n",
        "                        print(f\"  ✓ Tabela '{nome_tabela}' criada!\")\n",
        "                        print(f\"  - Colunas ({len(chunk.columns)}): {', '.join(chunk.columns.tolist())}\")\n",
        "                    else:\n",
        "                        # Iterações seguintes: adicionar dados\n",
        "                        chunk.to_sql(\n",
        "                            nome_tabela,\n",
        "                            conn,\n",
        "                            if_exists='append',\n",
        "                            index=False\n",
        "                        )\n",
        "                    \n",
        "                    total_linhas += len(chunk)\n",
        "                    print(f\"    Processadas {total_linhas:,} linhas...\", end='\\r')\n",
        "                \n",
        "                print(f\"\\n  ✓ Total de {total_linhas:,} registros inseridos!\")\n",
        "                \n",
        "            else:\n",
        "                # Ler arquivo completo para arquivos pequenos/médios\n",
        "                print(f\"  - Arquivo médio ({tamanho_arquivo:.1f} MB) - leitura completa\")\n",
        "                \n",
        "                df = pd.read_csv(\n",
        "                    caminho_completo,\n",
        "                    sep='\\t',\n",
        "                    compression='gzip',\n",
        "                    low_memory=False,\n",
        "                    na_values='\\\\N',\n",
        "                    dtype=dtype\n",
        "                )\n",
        "                \n",
        "                print(f\"  ✓ Arquivo lido com sucesso!\")\n",
        "                print(f\"  - Registros: {len(df):,}\")\n",
        "                print(f\"  - Colunas ({len(df.columns)}): {', '.join(df.columns.tolist())}\")\n",
        "                \n",
        "                # Salvar no banco de dados\n",
        "                df.to_sql(\n",
        "                    nome_tabela,\n",
        "                    conn,\n",
        "                    if_exists='replace',\n",
        "                    index=False,\n",
        "                    chunksize=10000\n",
        "                )\n",
        "                \n",
        "                print(f\"  ✓ Tabela '{nome_tabela}' criada no banco de dados!\")\n",
        "            \n",
        "        except FileNotFoundError:\n",
        "            print(f\"  ✗ ERRO: Arquivo não encontrado!\")\n",
        "            print(f\"    Caminho esperado: {caminho_completo}\")\n",
        "            \n",
        "        except MemoryError:\n",
        "            print(f\"  ✗ ERRO DE MEMÓRIA: Arquivo muito grande\")\n",
        "            print(f\"    Tente aumentar o tamanho dos chunks ou usar um dtype mais eficiente\")\n",
        "            \n",
        "        except Exception as e:\n",
        "            print(f\"  ✗ ERRO: {str(e)}\")\n",
        "    \n",
        "    print(\"\\n\" + \"=\" * 70)\n",
        "    print(\"VERIFICANDO BANCO DE DADOS\")\n",
        "    print(\"=\" * 70)\n",
        "    \n",
        "    # Verificar as tabelas criadas\n",
        "    cursor = conn.cursor()\n",
        "    cursor.execute(\"SELECT name FROM sqlite_master WHERE type='table';\")\n",
        "    tabelas = cursor.fetchall()\n",
        "    \n",
        "    if tabelas:\n",
        "        print(f\"\\nTabelas criadas: {len(tabelas)}\")\n",
        "        for tabela in tabelas:\n",
        "            nome_tab = tabela[0]\n",
        "            print(f\"\\n[{nome_tab.upper()}]\")\n",
        "            \n",
        "            # Contar registros\n",
        "            cursor.execute(f\"SELECT COUNT(*) FROM {nome_tab}\")\n",
        "            count = cursor.fetchone()[0]\n",
        "            print(f\"  - Registros: {count:,}\")\n",
        "            \n",
        "            # Listar colunas\n",
        "            cursor.execute(f\"PRAGMA table_info({nome_tab})\")\n",
        "            colunas = cursor.fetchall()\n",
        "            colunas_nomes = [col[1] for col in colunas]\n",
        "            print(f\"  - Colunas ({len(colunas)}): {', '.join(colunas_nomes)}\")\n",
        "            \n",
        "            # Mostrar amostra de dados (primeiras 3 linhas)\n",
        "            cursor.execute(f\"SELECT * FROM {nome_tab} LIMIT 3\")\n",
        "            amostra = cursor.fetchall()\n",
        "            print(f\"  - Primeiras 3 linhas:\")\n",
        "            for i, linha in enumerate(amostra, 1):\n",
        "                print(f\"    {i}. {linha[:3]}...\")\n",
        "    else:\n",
        "        print(\"\\n⚠ Nenhuma tabela foi criada!\")\n",
        "    \n",
        "    # Fechar conexão\n",
        "    conn.close()\n",
        "    \n",
        "    print(\"\\n\" + \"=\" * 70)\n",
        "    print(f\"✓ PROCESSO CONCLUÍDO!\")\n",
        "    print(f\"  Banco de dados: {DB_NAME}\")\n",
        "    print(\"=\" * 70)\n",
        "\n",
        "if __name__ == '__main__':\n",
        "    criar_banco_dados()\n"
      ],
      "id": "848c09db",
      "execution_count": null,
      "outputs": []
    },
